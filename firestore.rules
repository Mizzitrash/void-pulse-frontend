rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions utilitaires ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getRoles() {
      let roles = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
      return roles is list ? roles : [roles];
    }

    function isAdminOrFounder() {
      return isSignedIn() &&
        (('ADMIN' in getRoles()) || ('FONDATEUR' in getRoles()) || ('FOUNDER' in getRoles()));
    }

    function isArtistRole() {
      return isSignedIn() &&
        (('ARTIST' in getRoles()) || ('ARTISTE' in getRoles()));
    }

    function isCommunityManager() {
      return isSignedIn() && ('COMMUNITY_MANAGER' in getRoles());
    }

    function isRealisateur() {
      return isSignedIn() && ('REALISATEUR' in getRoles());
    }

    function isManager() {
      return isSignedIn() && ('MANAGER' in getRoles());
    }

    function ownsArtistPage(artistId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (
        ('artistId' in profile && profile.artistId == artistId) ||
        request.auth.uid == artistId
      );
    }

    function canEditArtist(artistId) {
      return isSignedIn() && (
        isAdminOrFounder() ||
        isManager() ||
        (isArtistRole() && ownsArtistPage(artistId))
      );
    }

    // --- Collection users (profils) ---

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdminOrFounder() ||
        isCommunityManager()
      );

      // ⚠️ CORRECTIF CRITIQUE — escalade de privilèges.
      // L'ancienne règle (`allow create: if request.auth.uid == userId`)
      // laissait choisir le CONTENU du document créé. Un attaquant pouvait
      // s'inscrire via l'API Auth puis écrire directement dans Firestore
      // un profil avec roles: ['ADMIN'], sans jamais passer par le site :
      // isAdminOrFounder() relisait ce document et lui accordait tout.
      // On impose désormais le rôle de départ et on interdit de se lier
      // une page artiste dès la création.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.roles == ['USER']
        && !('artistId' in request.resource.data);

      // Modification de son propre profil, SANS toucher à roles ni artistId.
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('roles', null) == resource.data.get('roles', null)
        && request.resource.data.get('artistId', null) == resource.data.get('artistId', null);

      allow update: if isAdminOrFounder();

      // Aucune suppression de compte depuis le client.
      allow delete: if false;
    }

    // --- Collection artists ---

    match /artists/{artistId} {
      allow read: if true;
      allow create: if isAdminOrFounder();
      allow update: if canEditArtist(artistId);
      allow delete: if isAdminOrFounder();
    }

    // --- Collection posts (Actu) ---

    match /posts/{postId} {
      allow read: if true;
      allow create: if isCommunityManager() || isAdminOrFounder();

      // Les réactions restent ouvertes à tout connecté, mais on plafonne
      // désormais le nombre d'émojis distincts. Sans cette limite, un
      // compte pouvait écrire des milliers de clés dans le champ et gonfler
      // le document jusqu'au plafond de 1 Mo de Firestore.
      allow update: if isSignedIn() && (
        (isCommunityManager() || isAdminOrFounder()) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.keys().size() <= 20
        )
      );

      allow delete: if isCommunityManager() || isAdminOrFounder();
    }

    // --- Collection orders (commandes de beats) ---

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdminOrFounder());

      // Le statut est imposé à la création : personne ne peut déposer une
      // commande déjà marquée comme payée.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'simulated';

      allow update: if isAdminOrFounder();
      allow delete: if isAdminOrFounder();
    }

    // --- Collection discovery_items (page Découverte) ---

    match /discovery_items/{itemId} {
      allow read: if true;
      allow create: if isRealisateur() || isAdminOrFounder();
      allow update: if isRealisateur() || isAdminOrFounder();
      allow delete: if isRealisateur() || isAdminOrFounder();
    }

    // --- Collection submissions (candidatures "Rejoins-nous") ---

    function isValidSubmission() {
      let d = request.resource.data;
      return d.keys().hasAll(['artistName', 'email', 'message', 'status'])
        && d.keys().hasOnly([
             'artistName', 'email', 'phone', 'message',
             'linkUrl', 'fileUrl', 'filePath', 'status', 'createdAt'
           ])
        && d.artistName is string
        && d.artistName.size() > 0
        && d.artistName.size() <= 80
        && d.email is string
        && d.email.size() > 0
        && d.email.size() <= 120
        && d.message is string
        && d.message.size() > 0
        && d.message.size() <= 1000
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
        && (!('linkUrl' in d) || (d.linkUrl is string && d.linkUrl.size() <= 300))
        && (!('fileUrl' in d) || (d.fileUrl is string && d.fileUrl.size() <= 800))
        && (!('filePath' in d) || (d.filePath is string && d.filePath.size() <= 300))
        && d.status == 'new';
    }

    match /submissions/{submissionId} {
      allow read: if isManager() || isAdminOrFounder();
      // La page candidature exige désormais un compte : on l'impose aussi
      // côté serveur plutôt que de s'en remettre au routage React.
      allow create: if isSignedIn() && isValidSubmission();
      allow update, delete: if isManager() || isAdminOrFounder();
    }

    // --- Collection team (fiches publiques de l'équipe) ---

    function canHaveTeamCard() {
      return isCommunityManager() || isRealisateur() || isManager() || isAdminOrFounder();
    }

    function isValidTeamCard() {
      let d = request.resource.data;
      return d.keys().hasAll(['displayName', 'title'])
        && d.keys().hasOnly([
             'displayName', 'title', 'bio', 'photoUrl',
             'publicEmail', 'instagramUrl', 'youtubeUrl',
             'visible', 'order', 'updatedAt'
           ])
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 60
        && d.title is string && d.title.size() <= 60
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 800))
        && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 800))
        && (!('publicEmail' in d) || (d.publicEmail is string && d.publicEmail.size() <= 120))
        && (!('instagramUrl' in d) || (d.instagramUrl is string && d.instagramUrl.size() <= 300))
        && (!('youtubeUrl' in d) || (d.youtubeUrl is string && d.youtubeUrl.size() <= 300));
    }

    match /team/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid
        && canHaveTeamCard() && isValidTeamCard();
      allow write: if isAdminOrFounder();
    }

    // Tout le reste est refusé par défaut.
  }
}