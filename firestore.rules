rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fonctions utilitaires ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Gère le cas où "roles" est une string unique OU un tableau.
    function getRoles() {
      let roles = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
      return roles is list ? roles : [roles];
    }

    function isAdminOrFounder() {
      return isSignedIn() &&
        (('ADMIN' in getRoles()) || ('FONDATEUR' in getRoles()) || ('FOUNDER' in getRoles()));
    }

    function isArtistRole() {
      return isSignedIn() &&
        (('ARTIST' in getRoles()) || ('ARTISTE' in getRoles()));
    }

    // Vrai si le profil de l'utilisateur connecté est rattaché à cette
    // page artiste précise (par artistId, ou par ID direct en fallback).
    function ownsArtistPage(artistId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (
        ('artistId' in profile && profile.artistId == artistId) ||
        request.auth.uid == artistId
      );
    }

    function canEditArtist(artistId) {
      return isSignedIn() && (
        isAdminOrFounder() ||
        (isArtistRole() && ownsArtistPage(artistId))
      );
    }

    function isCommunityManager() {
      return isSignedIn() && ('COMMUNITY_MANAGER' in getRoles());
    }

    function isRealisateur() {
      return isSignedIn() && ('REALISATEUR' in getRoles());
    }

    // --- Collection users (profils) ---

    match /users/{userId} {
      // Avant : `allow read: if isSignedIn()` — n'importe quel membre
      // inscrit pouvait lire TOUTE la collection users (emails, rôles,
      // artistId de tout le monde). On restreint à son propre profil,
      // plus les rôles élevés qui en ont un besoin fonctionnel.
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdminOrFounder() ||
        isCommunityManager()
      );

      allow create: if isSignedIn() && request.auth.uid == userId;

      // Un utilisateur peut modifier son propre profil, MAIS SANS toucher
      // à roles ni artistId. On utilise .get(champ, défaut) plutôt que
      // .champ directement : accéder à une clé absente d'une map (ex:
      // artistId pour un utilisateur sans page liée) fait planter
      // l'évaluation de la règle entière, ce qui refusait à tort TOUTE
      // modification de profil (avatar inclus) pour ces utilisateurs.
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('roles', null) == resource.data.get('roles', null)
        && request.resource.data.get('artistId', null) == resource.data.get('artistId', null);

      // Un admin/fondateur peut tout modifier, y compris roles et artistId.
      allow update: if isAdminOrFounder();
    }

    // --- Collection artists ---

    match /artists/{artistId} {
      allow read: if true;
      allow create: if isAdminOrFounder();
      allow update: if canEditArtist(artistId);
      allow delete: if isAdminOrFounder();
    }

    // --- Collection posts (Actu) ---

    match /posts/{postId} {
      allow read: if true;

      allow create: if isCommunityManager() || isAdminOrFounder();

      // Les réactions restent ouvertes à tout connecté, mais SEULEMENT
      // sur le champ "reactions" — pas de réécriture du texte/image
      // d'un post par un simple visiteur.
      allow update: if isSignedIn() && (
        (isCommunityManager() || isAdminOrFounder()) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
      );

      allow delete: if isCommunityManager() || isAdminOrFounder();
    }

    // --- Collection orders (commandes de beats) ---

    match /orders/{orderId} {
      // Un client ne voit que ses propres commandes ; un admin voit tout.
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdminOrFounder());

      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;

      // Une commande est un historique immuable une fois créée.
      allow update: if isAdminOrFounder();
      allow delete: if isAdminOrFounder();
    }

    // --- Collection discovery_items (page Découverte) ---

    match /discovery_items/{itemId} {
      allow read: if true;
      allow create: if isRealisateur() || isAdminOrFounder();
      allow update: if isRealisateur() || isAdminOrFounder();
      allow delete: if isRealisateur() || isAdminOrFounder();
    }

    // Tout le reste est refusé par défaut.
  }
}