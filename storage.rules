rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Limite la taille des uploads à 10 Mo et impose un type image.
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Images liées aux posts d'actu — écriture réservée aux connectés
    // (la vérification de rôle CM/Admin se fait déjà côté Firestore Rules
    // sur la création du post ; ici on protège juste le fichier lui-même).
    match /posts/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
      allow delete: if isSignedIn();
    }

    // Images de pages artistes (avatar, bannière...).
    match /artists/{artistId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
      allow delete: if isSignedIn();
    }

    // Avatars de profil utilisateur.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Démos envoyées via la page "Rejoins-nous".
    // L'écriture est ouverte au public (pas de compte requis pour postuler),
    // ce qui expose au risque d'utiliser le bucket comme hébergement gratuit.
    // On le limite par un plafond de taille et une restriction stricte aux
    // formats audio/vidéo. La lecture reste fermée aux visiteurs anonymes.
    match /demos/{submissionId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('video/.*')
        );
      allow delete: if isSignedIn();
    }

    // Tout le reste est refusé par défaut.
  }
}