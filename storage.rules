rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
// LIMITE STRUCTURELLE À CONNAÎTRE
// Les règles Storage ne peuvent PAS lire Firestore : impossible d'y
// vérifier un rôle. Tout ce qu'on peut contrôler ici, c'est l'identité
// (request.auth.uid), la taille et le type du fichier. La protection
// contre l'abus automatisé vient de Firebase App Check, pas d'ici.
// ─────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Avatars — chacun n'écrit que dans SON dossier.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isImage(5);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Portraits de l'équipe (section "L'équipe" sur l'accueil).
    // Chemin distinct des avatars : une carte d'équipe s'affiche en
    // portrait 3:4 sur plusieurs centaines de pixels, là où un avatar
    // sert de pastille de 40 px. Réutiliser l'avatar donnait une image
    // étirée bien au-delà de sa définition, et recadrée de travers.
    match /team-photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isImage(8);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Images d'actualités.
    // Plafond ramené de 10 à 5 Mo : une illustration d'article n'a aucune
    // raison de peser davantage, et cela divise par deux ce qu'un compte
    // malveillant peut téléverser avant d'être remarqué.
    match /posts/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImage(5);
      allow delete: if isSignedIn();
    }

    // Démos envoyées via "Rejoins-nous".
    // AVANT : écriture ouverte à TOUT LE MONDE, sans authentification. Le
    // bucket devenait un hébergement de fichiers gratuit — 50 Mo par envoi,
    // en boucle, jusqu'à saturer le quota (et la facture). La page étant
    // désormais derrière RequireAuth, exiger un compte ne coûte rien et
    // ferme complètement ce vecteur.
    match /demos/{submissionId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('video/.*')
        );
      allow delete: if isSignedIn();
    }

    // Chemin /artists/ conservé mais fermé en écriture : aucun code du site
    // ne l'utilise (les visuels d'artistes sont saisis sous forme d'URL).
    // Le laisser ouvert offrait à n'importe quel compte connecté la
    // possibilité d'écraser ou de supprimer les fichiers d'un autre.
    match /artists/{artistId}/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }

    // Tout le reste est refusé par défaut.
  }
}
